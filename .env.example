# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-sonnet

# VS Code Integration
VSCODE_PORT=8080
VSCODE_HOST=localhost

# Multi-Agent Communication
AGENT_PORT=8081
AGENT_HOST=localhost

# Playwright Configuration
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT=30000

# File Operations
WORKSPACE_DIR=./workspace
MAX_FILE_SIZE=10485760  # 10MB

# Task Manager
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300000  # 5 minutes

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/assistant.log

# Security Settings
ENCRYPTION_KEY_FILE=./logs/encryption.key
API_KEY_STORAGE_FILE=./logs/api_keys.enc
MAX_API_KEY_AGE_DAYS=90
AUTO_ROTATE_API_KEYS=true

# Performance Settings
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_METRICS_INTERVAL=30
PERFORMANCE_ALERT_THRESHOLD=80

# Database Settings
DATABASE_URL=sqlite:///./db/assistant.db
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30

# Security Testing
SECURITY_SCAN_ENABLED=true
SECURITY_SCAN_INTERVAL=3600
COMPLIANCE_FRAMEWORKS=OWASP,GDPR,HIPAA

# Containerization Settings
DOCKER_HOST=localhost
KUBERNETES_CONFIG=~/.kube/config

# Cloud Infrastructure
CLOUD_PROVIDER=aws
CLOUD_REGION=us-east-1
CLOUD_ACCESS_KEY=your_cloud_access_key
CLOUD_SECRET_KEY=your_cloud_secret_key

# Development Settings
DEV_MODE=false
DEBUG_MODE=false
TEST_MODE=false

# AI Model Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_TOP_P=0.9
AI_FREQUENCY_PENALTY=0.0
AI_PRESENCE_PENALTY=0.0

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# WebSocket Settings
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_TIMEOUT=60
WEBSOCKET_HEARTBEAT_INTERVAL=30